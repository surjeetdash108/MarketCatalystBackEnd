# ─── Market Catalyst Backend — environment template ───────────────────────────
# Copy to `.env` for local dev:  cp .env.example .env  (then fill in real values)
# On Cloud Run, DO NOT ship this file — set these as Secret Manager secrets / env
# vars on the service instead (see deploy/DEPLOY.md).

# HTTP port. Locally 4100; Cloud Run injects its own PORT (8080) automatically.
PORT=4100
NODE_ENV=development

# ─── Service role ─────────────────────────────────────────────────────────────
# "worker" (default) mounts everything: sync jobs, purge, retention, feature
# flags, plans, and the ops monitor at /. Deployed --no-allow-unauthenticated.
#
# "live" mounts ONLY LiveModule + /health. That is what the PUBLIC Cloud Run
# service runs, so browsers can hold the ticker-tape SSE stream open without the
# admin routes existing at all — AdminGuard accepts an unauthenticated request
# when ADMIN_GUARD_TRUST_IAM is on, which is safe only behind Cloud Run IAM.
# Locally, leave unset. See deploy/DEPLOY.md §3b.
APP_ROLE=worker

# Browser origins allowed to call this service, comma-separated. UNSET = reflect
# any origin, which is what you want locally. Set it on the public live service.
# CORS_ORIGINS=https://marketcatalyst.web.app,http://localhost:3000

# This version of the app suppresses ALL scheduled/cron behavior on purpose —
# every read is triggered on-demand by the incoming request instead (see the
# UI-migration plan). Gates the two real in-process @Cron handlers
# (RetentionService, AutoPurgeJob). Cache-warm-up crons come back selectively,
# later. Leave false until that follow-up work starts.
ENABLE_SCHEDULED_JOBS=false

# Symbols scrolling in the header ticker tape, after the nine index/macro tiles.
# UNSET uses the built-in mega-cap list (see src/live/tape-universe.ts). All of
# them plus the eight ETF proxies travel in ONE /v3/snapshot request, so adding
# names here costs no extra vendor calls — only a longer strip.
# TAPE_STOCKS=AAPL,MSFT,NVDA,GOOGL,AMZN,META,TSLA,AVGO,JPM,V,XOM,LLY

# ─── Firebase / Firestore ─────────────────────────────────────────────────────
# Each field below is one field from the downloaded service-account key JSON —
# never check that JSON file in; these env vars ARE the credential. Locally
# they go in .env (gitignored); anywhere deployed they should be Secret
# Manager-backed env vars, same as POLYGON_API_KEY below. Only
# FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY are actually required for
# firebase-admin's cert() — leave everything below unset to fall back to
# Application Default Credentials instead (e.g. the Cloud Run runtime SA).
#
# FIREBASE_PROJECT_ID also doubles as the GCP/Firebase project the backend
# WRITES to — MUST match the project the frontend (Next.js) READS from, or
# the UI will see an empty database.
FIREBASE_PROJECT_ID=market-catalyst-stage
FIREBASE_TYPE=service_account
FIREBASE_PRIVATE_KEY_ID=
# Paste with literal \n for line breaks (one line in this file); the app
# expands them back into a real multi-line PEM key at startup.
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=
FIREBASE_UNIVERSE_DOMAIN=googleapis.com

# ─── Vendor API keys (server-side only — never exposed to the frontend) ────────
# Required for the core live data:
POLYGON_API_KEY=

# Polygon rebranded to Massive (Oct 2025). Both hosts were verified working on
# 2026-07-20 with the current key; api.polygon.io is being phased out.
POLYGON_API_BASE_URL=https://api.massive.com

# Inter-request delay for Polygon calls — both this service's own pagination
# (all tickers, dividends, IPOs) and the per-ticker loops in stock-history,
# options-chains and fundamentals-growth, which read it via
# PolygonService.requestDelayMs.
#
# 12500 is the FREE Basic tier's 5-calls-per-minute budget. EVERY PAID tier is
# unlimited — verified empirically on 2026-07-20: 12 parallel requests, zero 429s.
# Leave this at 0 on a paid key; at 12500 the two 60-ticker jobs each waste
# ~12.5 minutes per run sleeping for no reason.
POLYGON_PAGE_DELAY_MS=0

FMP_API_KEY=
FINNHUB_API_KEY=
FRED_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with a contact email (their policy).
SEC_EDGAR_USER_AGENT=Market Catalyst Backend hello@inc108.com

# Optional / not yet activated (jobs degrade gracefully when blank):
BENZINGA_API_KEY=
TRADIER_ACCESS_TOKEN=
UNUSUAL_WHALES_API_KEY=
ANTHROPIC_API_KEY=
ALPHAVANTAGE_API_KEY=
MEDIASTACK_API_KEY=

# ─── Vendor source routing (adapters.module.ts) ───────────────────────────────
# Each domain takes a primary and a fallback. Setting the fallback to "none"
# (or to the same vendor as the primary) runs that domain single-source WITHOUT
# losing swappability — every implementation stays registered, so switching
# vendors later is a change to these values only, never a code change.
# A primary of "none" is rejected at startup.
COMPANY_PROFILE_SOURCE=polygon
COMPANY_PROFILE_FALLBACK_SOURCE=fmp
MOVER_ENRICHMENT_SOURCE=polygon
MOVER_ENRICHMENT_FALLBACK_SOURCE=fmp
MOVERS_SOURCE=fmp
MOVERS_FALLBACK_SOURCE=polygon
# Polygon-only for REDISTRIBUTION compliance — Massive/Polygon is licensed to
# redistribute, Finnhub is not. "aggregate" (Polygon+Finnhub) exists for local
# experimentation only; never ship it. See adapters.module.ts.
NEWS_SOURCE=polygon

# Added 2026-07-20 — these four domains previously had their vendor priority
# hardcoded in try/catch blocks inside the jobs; they are now env-selectable.
DIVIDENDS_SOURCE=polygon
DIVIDENDS_FALLBACK_SOURCE=fmp
IPOS_SOURCE=polygon
# Polygon-only — was "finnhub". Finnhub is not redistribution-licensed, and
# Polygon's /vX/reference/ipos is authorised, so no fallback is needed.
IPOS_FALLBACK_SOURCE=none
SECTORS_SOURCE=polygon
SECTORS_FALLBACK_SOURCE=fmp
# QUOTE_* backs the market-indices ETF proxies.
QUOTE_SOURCE=polygon
QUOTE_FALLBACK_SOURCE=finnhub

# Single-vendor seams (only Polygon implements these today). The value list is
# in adapters.module.ts — adding a vendor means one new class plus one line
# there, with no change to any job.
MARKET_BARS_SOURCE=polygon
MARKET_BARS_FALLBACK_SOURCE=none
TICKER_UNIVERSE_SOURCE=polygon
TICKER_UNIVERSE_FALLBACK_SOURCE=none
FINANCIALS_SOURCE=polygon
FINANCIALS_FALLBACK_SOURCE=none

# ─── Error monitoring (optional; no-op until set) ─────────────────────────────
SENTRY_DSN=
