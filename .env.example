# MarketCatalystBackEnd — environment template (billing, email, admin, launch).
# Copy to .env for local dev. Secrets go in Secret Manager in staging/production,
# never in this file or in deploy/*.yaml. Every value containing PLACEHOLDER (or an
# example.com address) must be replaced before production — see docs/PLACEHOLDERS.md
# and run `node scripts/check-placeholders.mjs --production`.

# ── Billing ──────────────────────────────────────────────────────────────────
# fake = simulator (dev/staging only; startup fails in the production project)
# stripe = Stripe (adapter to be implemented) · empty = no provider ("launching soon")
BILLING_PROVIDER=
# Optional override; default OFF in the production project, ON elsewhere.
# The admin console's feature-flag toggle overrides it at runtime.
SUBSCRIPTIONS_ENABLED=
PRODUCTION_PROJECT_IDS=market-catalyst-502415
APP_URL=http://localhost:3000
FAKE_BILLING_WEBHOOK_SECRET=__PLACEHOLDER__

# ── Stripe (secrets: Secret Manager) ─────────────────────────────────────────
STRIPE_SECRET_KEY=__PLACEHOLDER__
STRIPE_WEBHOOK_SECRET=__PLACEHOLDER__
STRIPE_PORTAL_CONFIGURATION=bpc_PLACEHOLDER
# Optional: the provider creates the retention coupon itself; set only to use your own.
# STRIPE_RETENTION_COUPON_ID=
# Payment methods offered (Apple Pay / Google Pay ride on "card"). Add ",paypal" only if
# your account supports it; never crypto or UPI. Keep in step with the UI's
# NEXT_PUBLIC_STRIPE_PAYMENT_METHOD_TYPES.
STRIPE_PAYMENT_METHOD_TYPES=card,link
# Stripe Tax: product tax code for SaaS used by scripts/stripe-seed.ts (to confirm).
# Tax registrations (Texas first) are a Stripe dashboard setting — see docs/PLACEHOLDERS.md.
STRIPE_PRODUCT_TAX_CODE=__PLACEHOLDER__
# Webhook endpoint to register in Stripe: https://app.marketcatalyst.ai/api/billing/webhook
# Prices are resolved by lookup key (starter_monthly … elite_annual); IDs are printed by
# scripts/stripe-seed.ts for reference: price_starter_monthly_PLACEHOLDER etc.

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=console
EMAIL_PROVIDER_API_KEY=__PLACEHOLDER__
EMAIL_FROM_NAME="MarketCatalyst [PLACEHOLDER]"
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_REPLY_TO=support@example.com

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_REQUIRE_EMAIL_VERIFIED=true
ADMIN_REQUIRE_MFA=true

# ── Launch-day offer (scripts/launch-migration.ts) ───────────────────────────
LAUNCH_PROMO_PREFIX=LAUNCH_PLACEHOLDER
LAUNCH_PROMO_PERCENT=__PLACEHOLDER__

# ── Live streams ─────────────────────────────────────────────────────────────
STREAM_TICKET_SECRET=__PLACEHOLDER__

# ── Other contact strings ────────────────────────────────────────────────────
SEC_USER_AGENT="MarketCatalyst [PLACEHOLDER] contact@example.com"
